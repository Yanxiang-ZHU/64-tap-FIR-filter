#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5626cdeae600 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5626cdeae790 .scope module, "t" "t" 3 1;
 .timescale 0 0;
v0x5626cded4170_0 .var/real "a", 0 0;
v0x5626cdef53c0_0 .var/real "b", 0 0;
    .scope S_0x5626cdeae790;
T_0 ;
    %pushi/real 1610612736, 4066; load=1.50000
    %store/real v0x5626cded4170_0;
    %pushi/real 1207959552, 4067; load=2.25000
    %store/real v0x5626cdef53c0_0;
    %vpi_call/w 3 1 "$display", "a=%f b=%f", v0x5626cded4170_0, v0x5626cdef53c0_0 {0 0 0};
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "-";
    "t_sr.v";
